<!doctype html><meta charset=utf-8><title>Jim's to-do (Diary) 2026-11-15</title>
<style>body{font:15px system-ui,sans-serif;max-width:860px;margin:18px auto;padding:0 12px;line-height:1.45}h1{font-size:22px}h2{margin:22px 0 4px;font-size:17px;border-bottom:1px solid #8886}li{margin:7px 0;list-style:none}.s{color:#888;font-size:12.5px}code{background:#8882;padding:1px 4px;border-radius:3px;font-size:12px}a{word-break:break-all}input{margin-right:8px}</style>
